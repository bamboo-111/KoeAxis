{
  "profile": "real-align-recovery-v1",
  "protocol_version": "0.1.0-draft",
  "interface_version": "0.1.0-real-align-recovery",
  "schema_dialect": "closed-object-v1",
  "types": {
    "OperationRef": {
      "object": {
        "module_id": "id",
        "operation_id": "id",
        "interface_version": "id"
      }
    },
    "Identity": {
      "object": {
        "module_id": "id",
        "implementation_id": "id",
        "version": "id",
        "content_digest": "sha256"
      }
    },
    "ContentFile": {
      "object": {
        "path": "text",
        "sha256": "sha256"
      }
    },
    "ImplementationRecord": {
      "object": {
        "module_id": "id",
        "implementation_id": "id",
        "version": "id",
        "content_digest": "sha256",
        "admission": {
          "const": "temporary"
        },
        "source": "text",
        "content_files": {
          "array": "ContentFile"
        },
        "settings": "json"
      }
    },
    "AssemblyManifest": {
      "object": {
        "binding_id": "id",
        "implementations": {
          "array": "Identity"
        },
        "root_operations": {
          "array": "OperationRef"
        }
      }
    },
    "ArtifactRef": {
      "object": {
        "artifact_id": "id",
        "locator": "text",
        "representation": {
          "const": "application/json; charset=utf-8"
        },
        "permissions": {
          "array": {
            "enum": [
              "read",
              "write"
            ]
          }
        },
        "content_identity": {
          "union": [
            "sha256",
            "null"
          ]
        },
        "state_owner": "id",
        "writer_operation": "OperationRef",
        "lifetime": {
          "const": "run"
        }
      }
    },
    "CallContext": {
      "object": {
        "run_id": "id",
        "call_id": "id",
        "parent_call_id": {
          "union": [
            "id",
            "null"
          ]
        },
        "binding_id": "id",
        "cancellation_ref": "null",
        "trace_ref": "id",
        "resource_scope_id": "id"
      }
    },
    "CallEnvelope": {
      "object": {
        "protocol_version": {
          "const": "0.1.0-draft"
        },
        "target": "OperationRef",
        "context": "CallContext",
        "arguments": "json",
        "config_view": {
          "const": {
            "entries": {},
            "provenance": [],
            "evaluation_records": []
          }
        },
        "artifact_refs": {
          "array": "ArtifactRef"
        },
        "resource_handles": {
          "array": "json"
        }
      }
    },
    "SideEffectRecord": {
      "object": {
        "resource_ref": "json",
        "operation": {
          "enum": [
            "read",
            "write"
          ]
        },
        "commit_state": {
          "enum": [
            "not_started",
            "committed",
            "partial",
            "unknown"
          ]
        },
        "observation": "text",
        "evidence_ref": {
          "union": [
            "text",
            "null"
          ]
        }
      }
    },
    "BusinessError": {
      "object": {
        "category": "id",
        "legacy_identity": "text",
        "message": "text",
        "cause_chain": {
          "array": "json"
        },
        "partial_result": "json",
        "effects": {
          "array": "SideEffectRecord"
        }
      }
    },
    "HostRejection": {
      "object": {
        "code": {
          "enum": [
            "UNKNOWN_MODULE",
            "UNKNOWN_OPERATION",
            "VERSION_MISMATCH",
            "BINDING_MISMATCH",
            "UNDECLARED_DEPENDENCY",
            "INVALID_ENVELOPE",
            "CAPABILITY_DENIED",
            "STALE_HANDLE",
            "ADMISSION_MISMATCH"
          ]
        },
        "execution_started": {
          "const": false
        },
        "detail": "text",
        "external_mapping": {
          "const": null
        }
      }
    }
  },
  "modules": {
    "storage.artifacts": {
      "operations": {
        "write_fixture_json": {
          "input": {
            "object": {
              "path": "ArtifactRef",
              "payload": "json"
            }
          },
          "output": {
            "object": {
              "result": "json"
            }
          },
          "calls": [],
          "files": {
            "path": "write"
          },
          "host_capabilities": [],
          "resource_handles": []
        },
        "read_fixture_json": {
          "input": {
            "object": {
              "path": "ArtifactRef"
            }
          },
          "output": {
            "object": {
              "result": "json"
            }
          },
          "calls": [],
          "files": {
            "path": "read"
          },
          "host_capabilities": [],
          "resource_handles": []
        }
      }
    },
    "resource.execution": {
      "operations": {
        "acquire_gpu_lock": {
          "input": {
            "object": {
              "lock_path": "text",
              "output_root": "text",
              "timeout_seconds": "json",
              "stage": "text"
            }
          },
          "output": {
            "object": {
              "lease": "json"
            }
          },
          "calls": [],
          "files": {},
          "host_capabilities": [],
          "resource_handles": []
        },
        "release_gpu_lock": {
          "input": {
            "object": {
              "lock_path": "text",
              "holder": "text"
            }
          },
          "output": {
            "object": {
              "result": "json"
            }
          },
          "calls": [],
          "files": {},
          "host_capabilities": [],
          "resource_handles": []
        }
      }
    },
    "provider.mfa": {
      "operations": {
        "align_injected": {
          "input": {
            "object": {
              "work_dir": "text",
              "segment_id": {
                "const": "segment_000041"
              }
            }
          },
          "output": {
            "object": {
              "report": "json"
            }
          },
          "calls": [],
          "files": {},
          "host_capabilities": [],
          "resource_handles": []
        },
        "align_bound": {
          "input": {
            "object": {
              "work_dir": "text",
              "segment_id": "text",
              "source_audio": "text"
            }
          },
          "output": {
            "object": {
              "report": "json"
            }
          },
          "calls": [],
          "files": {},
          "host_capabilities": [],
          "resource_handles": []
        }
      }
    },
    "stage.align": {
      "operations": {
        "recover_segment": {
          "input": {
            "object": {
              "segment_id": {
                "const": "segment_000041"
              },
              "mode": {
                "enum": [
                  "offline",
                  "real"
                ]
              }
            }
          },
          "output": {
            "object": {
              "report": "json"
            }
          },
          "calls": [
            "provider.mfa/align_injected"
          ],
          "files": {},
          "host_capabilities": [],
          "resource_handles": []
        },
        "run_bound": {
          "input": {
            "object": {
              "mode": {
                "enum": [
                  "offline",
                  "real"
                ]
              },
              "transcript_source": "text",
              "raw_source": {
                "union": [
                  "text",
                  "null"
                ]
              },
              "work_dir": "text",
              "source_audio": "text"
            }
          },
          "output": {
            "object": {
              "report": "json"
            }
          },
          "calls": [
            "provider.mfa/align_bound"
          ],
          "files": {},
          "host_capabilities": [],
          "resource_handles": []
        }
      }
    },
    "test.real.align.recovery": {
      "operations": {
        "run": {
          "input": {
            "object": {
              "plan_id": {
                "const": "REAL-ALIGN-RECOVERY-001"
              }
            }
          },
          "output": {
            "object": {
              "report": "json"
            }
          },
          "calls": [
            "resource.execution/acquire_gpu_lock",
            "resource.execution/release_gpu_lock",
            "stage.align/recover_segment",
            "storage.artifacts/write_fixture_json"
          ],
          "files": {},
          "host_capabilities": [
            "snapshot"
          ],
          "resource_handles": [],
          "environment": [
            "REAL_ALIGN_RECOVERY_MODE"
          ]
        },
        "run_chain": {
          "input": {
            "object": {
              "plan_id": {
                "const": "REAL-CHAIN-ALIGN-001"
              }
            }
          },
          "output": {
            "object": {
              "report": "json"
            }
          },
          "calls": [
            "resource.execution/acquire_gpu_lock",
            "resource.execution/release_gpu_lock",
            "stage.align/run_bound",
            "storage.artifacts/write_fixture_json"
          ],
          "files": {},
          "host_capabilities": [
            "snapshot"
          ],
          "resource_handles": [],
          "environment": [
            "REAL_CHAIN_ALIGN_MODE"
          ]
        }
      }
    }
  },
  "open": [
    "offline root acquires and releases a real filelock and does not load a model or MFA",
    "REAL_ALIGN_RECOVERY_MODE=real is the explicit grant for one local GPU model at a time and MFA",
    "the filelock excludes cooperative callers of the same lock file, not an external GPU process",
    "segment_000041 only; not an episode pass and not a full ASR-to-subtitle chain"
  ]
}
