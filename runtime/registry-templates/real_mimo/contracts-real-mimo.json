{
  "profile": "real-mimo-v1",
  "protocol_version": "0.1.0-draft",
  "interface_version": "0.1.0-real-mimo",
  "schema_dialect": "closed-object-v1",
  "types": {
    "OperationRef": {
      "object": {
        "module_id": "id",
        "operation_id": "id",
        "interface_version": "id"
      }
    },
    "Identity": {
      "object": {
        "module_id": "id",
        "implementation_id": "id",
        "version": "id",
        "content_digest": "sha256"
      }
    },
    "ContentFile": {
      "object": {
        "path": "text",
        "sha256": "sha256"
      }
    },
    "ImplementationRecord": {
      "object": {
        "module_id": "id",
        "implementation_id": "id",
        "version": "id",
        "content_digest": "sha256",
        "admission": {
          "const": "temporary"
        },
        "source": "text",
        "content_files": {
          "array": "ContentFile"
        },
        "settings": "json"
      }
    },
    "AssemblyManifest": {
      "object": {
        "binding_id": "id",
        "implementations": {
          "array": "Identity"
        },
        "root_operations": {
          "array": "OperationRef"
        }
      }
    },
    "ArtifactRef": {
      "object": {
        "artifact_id": "id",
        "locator": "text",
        "representation": {
          "const": "application/json; charset=utf-8"
        },
        "permissions": {
          "array": {
            "enum": [
              "read",
              "write"
            ]
          }
        },
        "content_identity": {
          "union": [
            "sha256",
            "null"
          ]
        },
        "state_owner": "id",
        "writer_operation": "OperationRef",
        "lifetime": {
          "const": "run"
        }
      }
    },
    "CallContext": {
      "object": {
        "run_id": "id",
        "call_id": "id",
        "parent_call_id": {
          "union": [
            "id",
            "null"
          ]
        },
        "binding_id": "id",
        "cancellation_ref": "null",
        "trace_ref": "id",
        "resource_scope_id": "id"
      }
    },
    "CallEnvelope": {
      "object": {
        "protocol_version": {
          "const": "0.1.0-draft"
        },
        "target": "OperationRef",
        "context": "CallContext",
        "arguments": "json",
        "config_view": {
          "const": {
            "entries": {},
            "provenance": [],
            "evaluation_records": []
          }
        },
        "artifact_refs": {
          "array": "ArtifactRef"
        },
        "resource_handles": {
          "array": "json"
        }
      }
    },
    "SideEffectRecord": {
      "object": {
        "resource_ref": "json",
        "operation": {
          "enum": [
            "read",
            "write"
          ]
        },
        "commit_state": {
          "enum": [
            "not_started",
            "committed",
            "partial",
            "unknown"
          ]
        },
        "observation": "text",
        "evidence_ref": {
          "union": [
            "text",
            "null"
          ]
        }
      }
    },
    "BusinessError": {
      "object": {
        "category": "id",
        "legacy_identity": "text",
        "message": "text",
        "cause_chain": {
          "array": "json"
        },
        "partial_result": "json",
        "effects": {
          "array": "SideEffectRecord"
        }
      }
    },
    "HostRejection": {
      "object": {
        "code": {
          "enum": [
            "UNKNOWN_MODULE",
            "UNKNOWN_OPERATION",
            "VERSION_MISMATCH",
            "BINDING_MISMATCH",
            "UNDECLARED_DEPENDENCY",
            "INVALID_ENVELOPE",
            "CAPABILITY_DENIED",
            "STALE_HANDLE",
            "ADMISSION_MISMATCH"
          ]
        },
        "execution_started": {
          "const": false
        },
        "detail": "text",
        "external_mapping": {
          "const": null
        }
      }
    }
  },
  "modules": {
    "stage.audio_review": {
      "operations": {
        "run": {
          "input": {
            "object": {
              "mode": "id",
              "phase": "id",
              "output": "text"
            }
          },
          "output": {
            "object": {
              "report": "json"
            }
          },
          "calls": [],
          "files": {},
          "host_capabilities": [],
          "resource_handles": [],
          "environment": [
            "REAL_MIMO_ONLINE",
            "MIMO_API_KEY",
            "MIMO_BASE_URL",
            "REAL_CHAIN_MIMO_REUSE_CALLS",
            "OPT54_CONTENT_CONTEXT"
          ],
          "secret_environment": [
            "MIMO_API_KEY"
          ]
        },
        "run_bound": {
          "input": {
            "object": {
              "mode": "id",
              "phase": "id",
              "output": "text",
              "upstream": "text"
            }
          },
          "output": {
            "object": {
              "report": "json"
            }
          },
          "calls": [],
          "files": {},
          "host_capabilities": [],
          "resource_handles": [],
          "environment": [
            "REAL_MIMO_ONLINE",
            "MIMO_API_KEY",
            "MIMO_BASE_URL",
            "REAL_CHAIN_MIMO_REUSE_CALLS",
            "OPT54_CONTENT_CONTEXT"
          ],
          "secret_environment": [
            "MIMO_API_KEY"
          ]
        }
      }
    },
    "provider.audio_llm": {
      "operations": {
        "compare": {
          "input": {
            "object": {
              "mode": "id",
              "output": "text"
            }
          },
          "output": {
            "object": {
              "report": "json"
            }
          },
          "calls": [],
          "files": {},
          "host_capabilities": [],
          "resource_handles": [],
          "environment": [
            "REAL_MIMO_ONLINE",
            "MIMO_API_KEY",
            "MIMO_BASE_URL",
            "REAL_CHAIN_MIMO_REUSE_CALLS",
            "OPT54_CONTENT_CONTEXT"
          ],
          "secret_environment": [
            "MIMO_API_KEY"
          ]
        }
      }
    },
    "test.real.mimo": {
      "operations": {
        "run": {
          "input": {
            "object": {
              "plan_id": {
                "const": "REAL-MIMO-001"
              }
            }
          },
          "output": {
            "object": {
              "report": "json"
            }
          },
          "calls": [
            "stage.audio_review/run",
            "provider.audio_llm/compare",
            "stage.audio_review/run_bound"
          ],
          "files": {},
          "host_capabilities": [
            "snapshot"
          ],
          "resource_handles": [],
          "environment": [
            "REAL_MIMO_ONLINE",
            "REAL_CHAIN_BIND_UPSTREAM"
          ]
        },
        "run_chain": {
          "input": {
            "object": {
              "plan_id": {
                "const": "REAL-CHAIN-MIMO-FULL-001"
              }
            }
          },
          "output": {
            "object": {
              "report": "json"
            }
          },
          "calls": [
            "stage.audio_review/run_bound"
          ],
          "files": {},
          "host_capabilities": [
            "snapshot"
          ],
          "resource_handles": [],
          "environment": [
            "REAL_MIMO_ONLINE",
            "REAL_MIMO_CHAIN_UPSTREAM",
            "REAL_MIMO_CHAIN_RESUME_OUTPUT",
            "REAL_CHAIN_FINISH_HANDOFF",
            "REAL_CHAIN_LLM_SPEAKER_ENROLL",
            "REAL_CHAIN_LLM_SPEAKER_NPZ",
            "REAL_CHAIN_LLM_SOURCE_AUDIO",
            "REAL_CHAIN_MIMO_REUSE_CALLS"
          ]
        }
      }
    }
  },
  "open": [
    "offline root calls stage.audio_review/run and provider.audio_llm/compare and does not open a socket",
    "REAL_CHAIN_BIND_UPSTREAM selects stage.audio_review/run_bound through the same root; unset keeps the historical run",
    "REAL_MIMO_ONLINE=1 is the explicit online grant for the Token Plan endpoints only",
    "host environment.network remains a report field and is not changed",
    "not an episode pass and not a migration-equivalence claim"
  ]
}
