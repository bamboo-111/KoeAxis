# Example image for the KoeAxis CI control server (no GPU, no torch). Adjust freely.
# Build from the repository root:  docker build -f deploy/Dockerfile.server -t koeaxis-ci .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONIOENCODING=utf-8 \
    KOEAXIS_CI_DATA_DIR=/data KOEAXIS_CI_PRESETS_DIRS=/app/ci-presets
WORKDIR /app

COPY requirements-ci.txt ./
RUN pip install --no-cache-dir -r requirements-ci.txt

# Only the CI package is needed by the server. Presets reference files such as ../samples/*.xlsx;
# mount them (see docker-compose.yml) instead of baking user data into the image.
COPY qwen_asr/__init__.py qwen_asr/__init__.py
COPY qwen_asr/ci qwen_asr/ci
COPY ci-presets ci-presets

RUN useradd --system --uid 10001 koeaxis && mkdir -p /data && chown koeaxis /data
USER koeaxis
VOLUME ["/data"]
EXPOSE 8710
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8710/api/v1/health')"
CMD ["python", "-m", "qwen_asr.ci", "server", "--host", "0.0.0.0", "--port", "8710"]
