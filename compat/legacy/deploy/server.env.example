# KoeAxis CI server settings (all optional). See docs/CI.md section 3.
KOEAXIS_CI_DATA_DIR=/data
# KOEAXIS_CI_DB_URL=postgresql+psycopg://koeaxis:secret@db/koeaxis   # needs the driver installed in the image
KOEAXIS_CI_COOKIE_SECURE=1
KOEAXIS_CI_MAX_UPLOAD_MB=4096
# Trust X-Forwarded-For style identity only from the proxy network:
# KOEAXIS_CI_TRUSTED_USER_HEADER=Remote-User
# KOEAXIS_CI_TRUSTED_PROXY_IPS=172.16.0.0/12
# KOEAXIS_CI_TRUSTED_HEADER_AUTO_CREATE=1
# KOEAXIS_CI_WEBHOOK_URLS=https://hooks.example.com/koeaxis
# KOEAXIS_CI_WEBHOOK_SECRET=change-me
# KOEAXIS_CI_ROOT_PATH=/koeaxis
# KOEAXIS_CI_MEMBER_EXTRA_ARGS=0
